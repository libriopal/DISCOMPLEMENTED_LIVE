{
  "name": "@bicameral/shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Shared types, schemas, and constants — used by both public app and private admin module",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./schemas": "./src/schemas.ts",
    "./constants": "./src/constants.ts",
    "./errors": "./src/errors.ts",
    "./glaas": "./src/glaas/index.ts",
    "./glaas/lattice": "./src/glaas/lattice.ts",
    "./glaas/proactive-detection": "./src/glaas/proactive-detection.ts",
