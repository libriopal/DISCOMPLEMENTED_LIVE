  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test:unit": "vitest run",
    "lint": "eslint src/ --ext .ts"
  },
  "dependencies": {
    "zod": "3.23.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
