{
  "name": "@bicameral/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Bicameral web app — Hono API + React 19 frontend on Cloudflare Workers",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev",
    "dev:all": "concurrently \"pnpm dev\" \"pnpm dev:api\"",
    "build": "vite build",
    "deploy": "pnpm build && wrangler deploy --env production",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/standalone": "^7.26.0",
    "@bicameral/admin": "link:packages/admin-stub",
    "@bicameral/cohere": "workspace:*",
    "@bicameral/shared": "workspace:*",
    "@fluxy-chat/sdk": "0.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-query": "5.0.0",
    "@tanstack/react-router": "1.0.0",
    "better-auth": "1.6.26",
    "esbuild-wasm": "^0.25.12",
    "framer-motion": "11.0.0",
    "hono": "4.13.1",
    "kysely": "0.29.4",
    "kysely-d1": "0.3.0",
    "lucide-react": "^0.460.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "stripe": "17.0.0",
    "three": "0.170.0",
    "zod": "3.23.0",
    "zustand": "5.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.20.3",
    "@cloudflare/workers-types": "5.20260809.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "6.0.5",
    "concurrently": "10.0.4",
    "msw": "2.15.0",
    "playwright": "1.62.1",
    "typescript": "5.9.3",
    "unocss": "66.7.5",
    "vite": "8.2.1",
    "vitest": "4.1.11",
    "wrangler": "4.120.0"
  }
}
