  "$themesDescription": "Tier 2 semantic aliases, one block per theme. build.cjs emits each as a [data-theme='<id>'] rule; the theme flagged $default also matches bare :root, so it applies before any attribute is set. Default order matters — CSS custom-property specificity ties between :root and [data-theme] are broken by source order, so the default block is emitted first. Adding a theme is a data change here plus `node tokens/build.cjs`; no component edits.",
  "themes": {
    "dark": {
      "$label": "Dark",
      "$scheme": "dark",
      "$default": true,
      "$note": "Scorpio surfaces and text with the Magenta/Cyan accent split. This is what shipped and what the accent semantics in this file describe.",
